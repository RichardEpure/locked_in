{
    "name": "locked_in",
    "version": "0.1.0",
    "private": true,
    "description": "",
    "main": "index.js",
    "scripts": {
        "dev": "npm run css:build && concurrently --kill-others \"npm:css:watch\" \"dx serve --desktop\"",
        "css:build": "sass --style=expanded --no-source-map assets/styles/main.scss assets/styles/main.css",
        "css:build:release": "sass --style=compressed --no-source-map assets/styles/main.scss assets/styles/main.css",
        "css:watch": "sass --no-source-map --watch assets/styles/main.scss assets/styles/main.css",
        "bundle": "npm run css:build:release && dx bundle --desktop --release --locked",
        "test": "npm run css:build && cargo test --locked",
        "verify": "cargo fmt --all --check && npm test && cargo clippy --locked --all-targets -- -D warnings && npm run bundle"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RichardEpure/locked_in.git"
    },
    "keywords": [],
    "author": "",
    "license": "AGPL-3.0-only",
    "bugs": {
        "url": "https://github.com/RichardEpure/locked_in/issues"
    },
    "homepage": "https://github.com/RichardEpure/locked_in#readme",
    "devDependencies": {
        "concurrently": "9.2.4",
        "sass": "1.97.1"
    }
}
